#!/bin/bash
# Test double: a window exists while $STUB_LAYOUT is set; `do` calls are logged.
case $1 in
  status)
    [[ -n ${STUB_LAYOUT:-} ]] || exit 1
    printf '{"layout": "%s", "errors": []}\n' "$STUB_LAYOUT"
    ;;
  do)
    shift
    echo "$*" >>"$STUB_CALLS"
    echo '{"ok": true}'
    ;;
  *) exit 2 ;;
esac
